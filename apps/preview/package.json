    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "mermaid": "12.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
